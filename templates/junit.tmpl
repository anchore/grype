<?xml version="1.0" ?>
<testsuites name="grype-junit">
{{- $failures := len $.Matches }}
    <testsuite tests="{{ $failures }}" failures="{{ $failures }}" name="{{ html $.Distro.Name }}:{{ html $.Distro.Version }}" errors="0" skipped="0">
        <properties>
            <property name="type" value="{{ html $.Distro.Name }}"></property>
        </properties>
        {{- range .Matches }}
        <testcase classname="{{ html .Artifact.Name }}-{{ html .Artifact.Version }} ({{ html .Artifact.Type }})" name="[{{ html .Vulnerability.Severity }}] {{ html .Vulnerability.ID }}">
            <failure message="{{ html .Artifact.Name }}: {{ html .Vulnerability.ID }}" type="description">
<![CDATA[
{{ html .Vulnerability.Description }}

CPEs:
{{- range .Artifact.CPEs }}
{{ . }}
{{- end }}

DataSource:
{{ html .Vulnerability.DataSource }}

]]></failure>
        </testcase>
        {{- end }}
    </testsuite>
</testsuites>
